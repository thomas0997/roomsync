# Copy to .env (never commit .env). Fill in real values locally.
DATABASE_URL=sqlite:///./roomsync.db
SECRET_KEY=change-me-run-python3--c-"import secrets;print(secrets.token_urlsafe(48))"
ENV=development
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# Uploaded files: leave these four EMPTY locally (files then stay in the local database).
# On Render they point at the private Cloudflare R2 bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
